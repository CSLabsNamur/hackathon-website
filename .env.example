# Nuxt SEO
#NUXT_SITE_ENV="staging"
NUXT_SITE_URL="http://localhost:3000"
NUXT_SITE_NAME="Le Hackathon du CSLabs"
NUXT_SITE_DESCRIPTION="Le Hackathon du CSLabs : 48h pour imaginer, prototyper et présenter un projet tech en équipe."

# Required in production for OG image signing: at least 32 random characters.
# For local Docker, generate a value with: openssl rand -hex 32
NUXT_APP_SECRET=""

# Cloudflare Turnstile
NUXT_TURNSTILE_SITE_KEY=""
NUXT_TURNSTILE_SECRET_KEY=""

# Email
NUXT_SMTP_HOST="localhost"
NUXT_SMTP_PORT="1025"
NUXT_SMTP_SECURE="false"
NUXT_SMTP_USER="test"
NUXT_SMTP_PASSWORD="test"
NUXT_SMTP_REPLY_TO="event@cslabs.be"

# Supabase client
SUPABASE_URL="https://supabase-hackathon.cslabs.be"
SUPABASE_KEY="sb_publishable_XXX"
SUPABASE_SECRET_KEY="sb_secret_XXX"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Optional local Docker PostgreSQL settings. If changed, update DATABASE_URL for pnpm dev.
# POSTGRES_DB="postgres"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="password"
# POSTGRES_PORT="5432"

# Optional local Maildev host ports. If SMTP changes, update NUXT_SMTP_PORT for pnpm dev.
# MAILDEV_WEB_PORT="1080"
# MAILDEV_SMTP_PORT="1025"

# Local Docker HTTP port (Coolify uses its proxy instead).
# APP_PORT="3000"

# ClamAV
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
