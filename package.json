{
  "name": "@cslabs/hackathon-website",
  "description": "CSLabs' Hackathon Website",
  "version": "1.8.0",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "CSLabs",
  "contributors": [
    {
      "name": "Martin Jacob",
      "email": "martin.jcb@proton.me"
    }
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSLabsNamur/hackathon-website.git"
  },
  "scripts": {
    "postinstall": "nuxt prepare && pnpm run db:generate",
    "predev": "pnpm run mail:generate && pnpm run db:generate && pnpm run db:permission-sync",
    "prebuild": "pnpm run mail:generate && pnpm run db:generate",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck",
    "mail:generate": "tsx scripts/generate-mail-templates.ts",
    "start": "node .output/server/index.mjs",
    "db:permission-sync": "tsx scripts/permission-sync.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
