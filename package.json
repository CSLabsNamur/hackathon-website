    "@nuxtjs/mdc": "0.23.2",
    "@nuxtjs/seo": "6.0.1",
    "@nuxtjs/supabase": "2.1.0",
    "@nuxtjs/turnstile": "1.1.3",
    "@pinia/nuxt": "1.0.3",
