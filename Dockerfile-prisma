FROM node:22.23.4-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS dependencies

ENV COREPACK_HOME=/corepack
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY docker/prisma/package.json ./docker/prisma/package.json

RUN corepack enable && corepack install --global "$(node -p 'require("./package.json").packageManager')"
RUN --mount=type=cache,id=hackathon-pnpm,target=/pnpm/store,sharing=locked \
    pnpm --filter @cslabs/hackathon-migrations install --prod --frozen-lockfile --ignore-scripts --store-dir=/pnpm/store \
    && pnpm --filter @cslabs/hackathon-migrations deploy --prod /prisma

FROM dependencies AS generate

WORKDIR /prisma

COPY prisma.config.ts ./
COPY server/prisma/schema.prisma ./server/prisma/schema.prisma

RUN --network=none DATABASE_URL=postgresql://build:build@localhost:5432/build ./node_modules/.bin/prisma generate

FROM base AS runtime

ENV NODE_ENV=production

COPY --from=dependencies /prisma ./
COPY --from=generate /prisma/server/prisma/generated ./server/prisma/generated
COPY prisma.config.ts ./
COPY server/prisma/schema.prisma server/prisma/seed.ts ./server/prisma/
COPY server/prisma/migrations ./server/prisma/migrations
COPY shared/utils ./shared/utils
COPY server/utils/dayjs.ts ./server/utils/dayjs.ts
COPY --chmod=0755 docker-entrypoint.sh ./

ENTRYPOINT ["/app/docker-entrypoint.sh"]
